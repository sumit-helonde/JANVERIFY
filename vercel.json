{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm run build",
  "outputDirectory": "frontend/dist",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "includeFiles": "backend/app/**" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
