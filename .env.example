# JANVERIFY environment configuration (example)
# Copy to .env and fill in real values. NEVER commit a real .env file.

# --- Backend ---
# SQLAlchemy connection string for PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg://janverify:janverify_dev_password@localhost:5432/janverify

# Base URL of the backend API
API_BASE_URL=http://localhost:8000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# Secret used to sign JWT/session tokens (REQUIRED in backend/.env for production)
JWT_SECRET=change-me

# Optional LLM provider key (used by ai/ modules in later phases)
LLM_API_KEY=change-me

# --- Frontend ---
# Base URL the browser uses to reach the backend API.
# When using the Vite dev proxy, keep this as /api.
VITE_API_BASE_URL=/api