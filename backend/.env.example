# JANVERIFY backend (example environment)
# Copy to .env and fill in real values. NEVER commit a real .env.
# With Docker: postgresql+psycopg://janverify:janverify_dev_password@localhost:5432/janverify

DATABASE_URL=postgresql+psycopg://janverify:janverify_dev_password@localhost:5432/janverify
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me
LLM_API_KEY=

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development